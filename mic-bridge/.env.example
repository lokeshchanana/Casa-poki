# ==========================================
# Party Audio to MQTT Bridge Configuration
# ==========================================

# Home Assistant MQTT Broker
MQTT_HOST=192.168.1.251
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=party/audio

# Home Assistant MQTT Auto-Discovery
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant

# Audio Input Device
# Set to 'auto', an index like '1' (3.5mm ALC283 Analog jack), or 'MS2109' (USB)
AUDIO_DEVICE=1

# Audio Sampling Settings
SAMPLE_RATE=44100
BLOCK_SIZE=2048

# Sensitivity and Analysis
# SENSITIVITY: Gain multiplier for mic input volume (1.0 - 5.0)
SENSITIVITY=1.5
MIN_VOLUME_GATE=0.005
BEAT_SENSITIVITY=1.30
BEAT_COOLDOWN_MS=120

# MQTT Publishing Rate (milliseconds between state updates)
# 100ms = 10 updates per second (recommended for smooth responsiveness without flooding)
PUBLISH_INTERVAL_MS=100

LOG_LEVEL=INFO
