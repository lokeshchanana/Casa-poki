[Unit]
Description=Fiona Banks Google Drive & Email Bills Ingestion Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/docker exec agent-hub python3 /app/gdrive_bills_watcher.py
ExecStart=/usr/bin/docker exec agent-hub python3 /app/email_bills_watcher.py
TimeoutSec=300
StandardOutput=journal
StandardError=journal
